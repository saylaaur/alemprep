          {
            "type": "list",
            "items": [
              "$\\frac{\\sqrt{2} \\cdot \\sqrt[4]{8}}{\\sqrt[4]{2}} = 2^{\\frac{1}{2} + \\frac{3}{4} - \\frac{1}{4}} = 2^1 = 2$.",
              "$\\sqrt[3]{9} \\cdot \\sqrt[6]{9} = 9^{\\frac{1}{3} + \\frac{1}{6}} = 9^{\\frac{1}{2}} = 3$."
            ]
          }
        ]
      },
      {
        "kicker": "Сравнение",
