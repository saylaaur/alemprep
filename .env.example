# Режим данных. `local` — сайт работает БЕЗ Supabase и без входа: данные ученика
# (книги, повторения, настройки) лежат в браузере. Пусто или `supabase` — боевой режим.
# В локальном режиме Supabase-переменные ниже не нужны.
NEXT_PUBLIC_DATA_MODE=
# Enable video lessons, the problem bank, and the library in Supabase mode after applying 0042.
# Standalone demo mode already includes these features. School pilot mode keeps its verified scope.
NEXT_PUBLIC_CONTENT_V1_ENABLED=false

# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Server-only configuration. Never add the NEXT_PUBLIC_ prefix to these keys.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
ANTHROPIC_API_KEY=replace-with-anthropic-api-key

# Telegram-напоминания о повторении книг (необязательно; без них кнопка в настройках скрыта)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=AlemPrepBot
TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
# Vercel Cron присылает его в заголовке Authorization для /api/cron/book-reminders
CRON_SECRET=replace-with-random-secret
